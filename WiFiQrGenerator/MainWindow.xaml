<Window x:Class="WiFiQrGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wi-Fi QR Generator"
        Height="650" Width="720"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Settings panel -->
        <GroupBox x:Name="SettingsGroup" Grid.Row="0" Margin="0,0,0,8" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="SsidLabel" Grid.Row="0" Grid.Column="0"
                           Margin="0,4,8,4" VerticalAlignment="Center"/>
                <TextBox x:Name="SsidBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                         Margin="0,4" Padding="4,2"/>

                <TextBlock x:Name="PasswordLabel" Grid.Row="1" Grid.Column="0"
                           Margin="0,4,8,4" VerticalAlignment="Center"/>
                <PasswordBox x:Name="PasswordInput" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                             Margin="0,4" Padding="4,2"/>

                <TextBlock x:Name="AuthLabel" Grid.Row="2" Grid.Column="0"
                           Margin="0,4,8,4" VerticalAlignment="Center"/>
                <ComboBox x:Name="AuthCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                          Margin="0,4">
                    <ComboBoxItem Tag="WPA">WPA/WPA2</ComboBoxItem>
                    <ComboBoxItem Tag="WEP">WEP</ComboBoxItem>
                    <ComboBoxItem Tag="nopass">nopass</ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="SavePathLabel" Grid.Row="3" Grid.Column="0"
                           Margin="0,4,8,4" VerticalAlignment="Center"/>
                <TextBox x:Name="SavePathBox" Grid.Row="3" Grid.Column="1"
                         Margin="0,4" Padding="4,2"/>
                <Button x:Name="BrowseButton" Grid.Row="3" Grid.Column="2"
                        Margin="6,4,0,4" Padding="10,2" Click="BrowseButton_Click"/>

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                            Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="SaveAsImageCheck" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="OpenAfterCheck" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="EnglishCheck" VerticalAlignment="Center"
                              Checked="EnglishCheck_Changed" Unchecked="EnglishCheck_Changed"/>
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                            Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                    <Button x:Name="LoadConfigButton" Margin="0,0,8,0" Padding="12,4"
                            Click="LoadConfigButton_Click"/>
                    <Button x:Name="SaveConfigButton" Margin="0,0,8,0" Padding="12,4"
                            Click="SaveConfigButton_Click"/>
                    <Button x:Name="GenerateButton" Padding="16,4" FontWeight="Bold"
                            Click="GenerateButton_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Colored log window -->
        <RichTextBox x:Name="LogBox" Grid.Row="1"
                     Background="Black"
                     FontFamily="Consolas" FontSize="12"
                     IsReadOnly="True"
                     BorderThickness="1" BorderBrush="#444"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     IsDocumentEnabled="False"/>
    </Grid>
</Window>